/**
 * OpenRFD — Client-side JavaScript
 *
 * Features:
 * - Annotation sidebar rendering and highlight linking
 * - Text selection for annotation creation
 * - GitHub OAuth (device flow + PKCE)
 * - Live PR discussion (fetched via GitHub API)
 * - Cmd+K search modal
 * - Table sorting and state filtering on index page
 */

(function () {
  'use strict';

  // ---------------------------------------------------------------------------
  // GitHub OAuth
  // ---------------------------------------------------------------------------

  const TOKEN_KEY = 'openrfd_github_token';
  const USER_KEY = 'openrfd_github_user';

  function getToken() {
    return localStorage.getItem(TOKEN_KEY);
  }

  function getUser() {
    try { return JSON.parse(localStorage.getItem(USER_KEY)); } catch { return null; }
  }

  function setAuth(token, user) {
    localStorage.setItem(TOKEN_KEY, token);
    localStorage.setItem(USER_KEY, JSON.stringify(user));
  }

  function clearAuth() {
    localStorage.removeItem(TOKEN_KEY);
    localStorage.removeItem(USER_KEY);
  }

  /**
   * GitHub Device Flow OAuth.
   * 1. POST to /login/device/code to get user_code + device_code
   * 2. Direct user to github.com/login/device to enter code
   * 3. Poll /login/oauth/access_token until granted
   */
  async function deviceFlowLogin(clientId) {
    const codeRes = await fetch('https://github.com/login/device/code', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ client_id: clientId, scope: 'repo' })
    });
    const codeData = await codeRes.json();

    // Show the user code
    const msg = `Enter code ${codeData.user_code} at github.com/login/device`;
    if (!confirm(msg + '\n\nClick OK after entering the code.')) return null;

    window.open(codeData.verification_uri, '_blank');

    // Poll for token
    const interval = (codeData.interval || 5) * 1000;
    const expires = Date.now() + (codeData.expires_in || 900) * 1000;

    while (Date.now() < expires) {
      await new Promise(r => setTimeout(r, interval));

      const tokenRes = await fetch('https://github.com/login/oauth/access_token', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          client_id: clientId,
          device_code: codeData.device_code,
          grant_type: 'urn:ietf:params:oauth:grant-type:device_code'
        })
      });
      const tokenData = await tokenRes.json();

      if (tokenData.access_token) {
        // Fetch user info
        const userRes = await fetch('https://api.github.com/user', {
          headers: { Authorization: `Bearer ${tokenData.access_token}` }
        });
        const user = await userRes.json();
        setAuth(tokenData.access_token, { login: user.login, name: user.name, avatar: user.avatar_url });
        return tokenData.access_token;
      }

      if (tokenData.error === 'expired_token') break;
      // 'authorization_pending' or 'slow_down' — keep polling
    }

    return null;
  }

  /**
   * PKCE Web Flow OAuth.
   * Used when a redirect_uri is configured.
   */
  function pkceLogin(clientId, redirectUri) {
    // Generate code verifier and challenge
    const verifier = generateRandomString(64);
    sessionStorage.setItem('openrfd_pkce_verifier', verifier);

    sha256(verifier).then(function (digest) {
      const challenge = base64UrlEncode(digest);
      const state = generateRandomString(16);
      sessionStorage.setItem('openrfd_pkce_state', state);

      const url = 'https://github.com/login/oauth/authorize?' + new URLSearchParams({
        client_id: clientId,
        redirect_uri: redirectUri,
        scope: 'repo',
        state: state,
        code_challenge: challenge,
        code_challenge_method: 'S256'
      }).toString();

      window.location.href = url;
    });
  }

  async function handlePkceCallback() {
    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');
    const state = params.get('state');
    if (!code || !state) return;

    const savedState = sessionStorage.getItem('openrfd_pkce_state');
    const verifier = sessionStorage.getItem('openrfd_pkce_verifier');
    if (state !== savedState || !verifier) return;

    sessionStorage.removeItem('openrfd_pkce_state');
    sessionStorage.removeItem('openrfd_pkce_verifier');

    // Exchange code for token (this needs a server-side proxy or GitHub App)
    // For now, this is a placeholder — GitHub doesn't support PKCE for OAuth Apps natively.
    // With a GitHub App, you'd exchange via a proxy endpoint.
    console.log('PKCE callback received. Code exchange requires server-side proxy.');

    // Clean URL
    window.history.replaceState({}, '', window.location.pathname);
  }

  function generateRandomString(length) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';
    let result = '';
    const values = crypto.getRandomValues(new Uint8Array(length));
    for (let i = 0; i < length; i++) result += chars[values[i] % chars.length];
    return result;
  }

  async function sha256(str) {
    const encoder = new TextEncoder();
    return await crypto.subtle.digest('SHA-256', encoder.encode(str));
  }

  function base64UrlEncode(buffer) {
    const bytes = new Uint8Array(buffer);
    let str = '';
    for (const b of bytes) str += String.fromCharCode(b);
    return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  // ---------------------------------------------------------------------------
  // GitHub API helpers
  // ---------------------------------------------------------------------------

  async function githubFetch(path, opts) {
    const token = getToken();
    if (!token) return null;
    const res = await fetch(`https://api.github.com${path}`, {
      ...opts,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/vnd.github.v3+json',
        ...(opts && opts.headers)
      }
    });
    if (res.status === 401) { clearAuth(); return null; }
    return res.json();
  }

  // ---------------------------------------------------------------------------
  // Annotations
  // ---------------------------------------------------------------------------

  function renderAnnotations(annotations) {
    const list = document.getElementById('annotation-list');
    const count = document.getElementById('annotation-count');
    if (!list || !annotations) return;

    // Separate top-level and replies
    const byId = {};
    const topLevel = [];
    const replies = {};

    for (const a of annotations) {
      byId[a.id] = a;
      if (a.motivation === 'replying' && typeof a.target === 'string') {
        if (!replies[a.target]) replies[a.target] = [];
        replies[a.target].push(a);
      } else {
        topLevel.push(a);
      }
    }

    if (count) count.textContent = `(${annotations.length})`;

    list.innerHTML = '';

    for (const a of topLevel) {
      const card = createAnnotationCard(a);

      // Add replies
      if (replies[a.id]) {
        const repliesDiv = document.createElement('div');
        repliesDiv.className = 'annotation-replies';
        for (const reply of replies[a.id]) {
          repliesDiv.appendChild(createAnnotationCard(reply));
        }
        card.appendChild(repliesDiv);
      }

      list.appendChild(card);
    }

    // Highlight annotated text in the content
    highlightAnnotations(topLevel);
  }

  function createAnnotationCard(a) {
    const card = document.createElement('div');
    card.className = 'annotation-card' + (a.resolved ? ' resolved' : '');
    card.dataset.annotationId = a.id;

    const meta = document.createElement('div');
    meta.className = 'annotation-meta';

    const author = document.createElement('span');
    author.className = 'author';
    author.textContent = a.creator ? a.creator.name : 'Unknown';
    meta.appendChild(author);

    const date = document.createElement('span');
    date.textContent = a.created ? new Date(a.created).toLocaleDateString() : '';
    meta.appendChild(date);

    card.appendChild(meta);

    // Quoted text
    if (a.target && a.target.selector) {
      for (const sel of a.target.selector) {
        if (sel.type === 'TextQuoteSelector' && sel.exact) {
          const quote = document.createElement('div');
          quote.className = 'annotation-quote';
          quote.textContent = sel.exact.length > 80 ? sel.exact.slice(0, 80) + '...' : sel.exact;
          card.appendChild(quote);
          break;
        }
      }
    }

    // Body
    const body = document.createElement('div');
    body.className = 'annotation-body';
    body.innerHTML = simpleMarkdown(a.body ? a.body.value : '');
    card.appendChild(body);

    // Click to scroll to highlighted text
    card.addEventListener('click', function () {
      const highlighted = document.querySelector(`[data-source].annotation-highlight[data-annotation-id="${a.id}"]`);
      if (highlighted) {
        highlighted.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    return card;
  }

  function highlightAnnotations(annotations) {
    for (const a of annotations) {
      if (!a.target || !a.target.selector) continue;
      for (const sel of a.target.selector) {
        if (sel.type === 'TextQuoteSelector' && sel.exact) {
          highlightTextInContent(sel.exact, a.id);
          break;
        }
      }
    }
  }

  function highlightTextInContent(text, annotationId) {
    const content = document.getElementById('rfd-content');
    if (!content) return;

    // Find elements with data-source that contain this text
    const elements = content.querySelectorAll('[data-source]');
    for (const el of elements) {
      if (el.textContent.includes(text)) {
        el.classList.add('annotation-highlight');
        el.dataset.annotationId = annotationId;

        el.addEventListener('click', function () {
          const card = document.querySelector(`.annotation-card[data-annotation-id="${annotationId}"]`);
          if (card) {
            // Remove active from all
            document.querySelectorAll('.annotation-card.active').forEach(c => c.classList.remove('active'));
            card.classList.add('active');
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });

        break; // Only highlight first match
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Text selection for annotation creation
  // ---------------------------------------------------------------------------

  function setupTextSelection() {
    const content = document.getElementById('rfd-content');
    const popover = document.getElementById('annotation-popover');
    if (!content || !popover) return;

    content.addEventListener('mouseup', function (e) {
      const selection = window.getSelection();
      if (!selection || selection.isCollapsed) {
        popover.style.display = 'none';
        return;
      }

      const text = selection.toString().trim();
      if (!text || text.length < 3) return;

      // Only show popover if user is authenticated
      if (!getToken()) return;

      // Position popover near the selection
      const range = selection.getRangeAt(0);
      const rect = range.getBoundingClientRect();
      popover.style.display = 'block';
      popover.style.top = (rect.bottom + window.scrollY + 8) + 'px';
      popover.style.left = Math.max(8, rect.left + window.scrollX - 100) + 'px';

      popover.dataset.selectedText = text;

      // Find the data-source element
      let sourceEl = range.startContainer;
      while (sourceEl && sourceEl !== content) {
        if (sourceEl.dataset && sourceEl.dataset.source) break;
        sourceEl = sourceEl.parentElement;
      }
      if (sourceEl && sourceEl.dataset) {
        popover.dataset.sourceRange = sourceEl.dataset.source;
      }
    });

    // Cancel button
    const cancelBtn = document.getElementById('annotation-cancel');
    if (cancelBtn) {
      cancelBtn.addEventListener('click', function () {
        popover.style.display = 'none';
        document.getElementById('annotation-input').value = '';
      });
    }

    // Submit button
    const submitBtn = document.getElementById('annotation-submit');
    if (submitBtn) {
      submitBtn.addEventListener('click', function () {
        const text = popover.dataset.selectedText;
        const comment = document.getElementById('annotation-input').value.trim();
        if (!text || !comment) return;

        // Build annotation
        const rfdNumber = window.__RFD_NUMBER__;
        const annotation = {
          '@context': 'http://www.w3.org/ns/anno.jsonld',
          type: 'Annotation',
          id: `urn:openrfd:${rfdNumber}:${crypto.randomUUID()}`,
          creator: { type: 'Person', name: getUser()?.login || 'anonymous' },
          created: new Date().toISOString(),
          motivation: 'commenting',
          body: { type: 'TextualBody', value: comment, format: 'text/markdown' },
          target: {
            type: 'SpecificResource',
            source: `rfd/${rfdNumber}/README.md`,
            selector: [{ type: 'TextQuoteSelector', exact: text }]
          }
        };

        // Add to local display
        if (window.__ANNOTATIONS__) {
          window.__ANNOTATIONS__.push(annotation);
          renderAnnotations(window.__ANNOTATIONS__);
        }

        popover.style.display = 'none';
        document.getElementById('annotation-input').value = '';

        // TODO: Commit annotation to rfd/<NNNN> branch via GitHub Contents API
        console.log('Annotation created (local only):', annotation);
      });
    }
  }

  // ---------------------------------------------------------------------------
  // Live PR Discussion
  // ---------------------------------------------------------------------------

  async function loadPrComments() {
    if (!window.__RFD_DISCUSSION__ || !getToken()) return;

    // Extract PR URL parts
    const match = window.__RFD_DISCUSSION__.match(/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/);
    if (!match) return;

    const [, owner, repo, prNumber] = match;

    const comments = await githubFetch(`/repos/${owner}/${repo}/pulls/${prNumber}/comments`);
    if (!comments || !Array.isArray(comments)) return;

    const prSection = document.getElementById('pr-comments');
    const prList = document.getElementById('pr-comment-list');
    if (!prSection || !prList) return;

    prSection.style.display = 'block';
    prList.innerHTML = '';

    for (const c of comments) {
      const card = document.createElement('div');
      card.className = 'pr-comment-card';

      const meta = document.createElement('div');
      meta.className = 'annotation-meta';
      meta.innerHTML = `<span class="author">${escapeHtml(c.user?.login || 'unknown')}</span>
        <span>${new Date(c.created_at).toLocaleDateString()}</span>
        <span class="source-tag">via PR</span>`;
      card.appendChild(meta);

      const body = document.createElement('div');
      body.className = 'annotation-body';
      body.innerHTML = simpleMarkdown(c.body || '');
      card.appendChild(body);

      prList.appendChild(card);
    }
  }

  // Check for active revision
  async function checkActiveRevision() {
    if (!getToken() || !window.__RFD_NUMBER__) return;

    const banner = document.getElementById('revision-banner');
    if (!banner) return;

    // Try to find an open PR for this RFD's branch
    // This requires knowing the owner/repo, which we can get from the discussion URL
    // or from the page URL
    // For now, this is a placeholder that works when discussion URL is set
  }

  // ---------------------------------------------------------------------------
  // Search (Cmd+K)
  // ---------------------------------------------------------------------------

  let searchIndex = null;

  async function loadSearchIndex() {
    try {
      const res = await fetch('/search-index.json');
      searchIndex = await res.json();
    } catch {
      searchIndex = [];
    }
  }

  function setupSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('modal-search-input');
    const headerInput = document.getElementById('search-input');
    const results = document.getElementById('search-results');

    if (!modal || !input || !results) return;

    // Cmd+K or Ctrl+K opens modal
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        modal.style.display = modal.style.display === 'none' ? 'flex' : 'none';
        if (modal.style.display === 'flex') {
          input.focus();
          input.value = '';
          results.innerHTML = '';
        }
      }
      if (e.key === 'Escape') {
        modal.style.display = 'none';
      }
    });

    // Click backdrop to close
    modal.addEventListener('click', function (e) {
      if (e.target === modal) modal.style.display = 'none';
    });

    // Header search input focuses modal
    if (headerInput) {
      headerInput.addEventListener('focus', function () {
        modal.style.display = 'flex';
        input.focus();
        headerInput.blur();
      });
    }

    // Search on input
    input.addEventListener('input', function () {
      const q = input.value.trim().toLowerCase();
      if (!q || !searchIndex) {
        results.innerHTML = '';
        return;
      }

      const matches = searchIndex.filter(function (entry) {
        return entry.title.toLowerCase().includes(q) ||
               entry.body.toLowerCase().includes(q) ||
               entry.number.includes(q) ||
               entry.authors.toLowerCase().includes(q);
      }).slice(0, 20);

      results.innerHTML = '';
      for (const m of matches) {
        const div = document.createElement('div');
        div.className = 'search-result';
        div.innerHTML = `<span class="result-number">RFD ${escapeHtml(m.number)}</span>
          ${escapeHtml(m.title)}
          <span class="result-state">${escapeHtml(m.state)}</span>`;
        div.addEventListener('click', function () {
          window.location.href = `/rfd/${m.number}/`;
        });
        results.appendChild(div);
      }
    });
  }

  // ---------------------------------------------------------------------------
  // Index page: sorting and filtering
  // ---------------------------------------------------------------------------

  function setupIndexPage() {
    const table = document.getElementById('rfd-table');
    const filter = document.getElementById('state-filter');
    if (!table) return;

    // State filter
    if (filter) {
      filter.addEventListener('change', function () {
        const val = filter.value;
        const rows = table.querySelectorAll('tbody tr');
        for (const row of rows) {
          if (!val || row.dataset.state === val) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        }
      });
    }

    // Column sorting
    const headers = table.querySelectorAll('th.sortable');
    let sortCol = null;
    let sortAsc = true;

    for (const th of headers) {
      th.addEventListener('click', function () {
        const col = th.dataset.sort;
        if (sortCol === col) {
          sortAsc = !sortAsc;
        } else {
          sortCol = col;
          sortAsc = true;
        }

        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const colIdx = Array.from(th.parentElement.children).indexOf(th);

        rows.sort(function (a, b) {
          const aText = a.children[colIdx]?.textContent.trim() || '';
          const bText = b.children[colIdx]?.textContent.trim() || '';
          const cmp = aText.localeCompare(bText, undefined, { numeric: true });
          return sortAsc ? cmp : -cmp;
        });

        for (const row of rows) tbody.appendChild(row);
      });
    }
  }

  // ---------------------------------------------------------------------------
  // Auth UI
  // ---------------------------------------------------------------------------

  function setupAuthUI() {
    const loginBtn = document.getElementById('login-btn');
    const userInfo = document.getElementById('user-info');
    const clientId = window.__GITHUB_CLIENT_ID__;

    if (!loginBtn || !clientId) return;

    const user = getUser();
    if (user) {
      loginBtn.style.display = 'none';
      if (userInfo) {
        userInfo.style.display = 'inline';
        userInfo.textContent = user.login;
        userInfo.style.cursor = 'pointer';
        userInfo.title = 'Click to sign out';
        userInfo.addEventListener('click', function () {
          if (confirm('Sign out?')) {
            clearAuth();
            window.location.reload();
          }
        });
      }
    } else {
      loginBtn.style.display = 'inline-flex';
      loginBtn.addEventListener('click', async function () {
        loginBtn.disabled = true;
        loginBtn.textContent = 'Signing in...';
        const token = await deviceFlowLogin(clientId);
        if (token) {
          window.location.reload();
        } else {
          loginBtn.disabled = false;
          loginBtn.textContent = 'Sign in with GitHub';
        }
      });
    }
  }

  // ---------------------------------------------------------------------------
  // Utilities
  // ---------------------------------------------------------------------------

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  /** Minimal markdown to HTML (bold, italic, code, links). */
  function simpleMarkdown(text) {
    return escapeHtml(text)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/`(.+?)`/g, '<code>$1</code>')
      .replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2">$1</a>')
      .replace(/\n/g, '<br>');
  }

  // ---------------------------------------------------------------------------
  // Init
  // ---------------------------------------------------------------------------

  document.addEventListener('DOMContentLoaded', function () {
    // Handle PKCE callback if present
    handlePkceCallback();

    // Load search index
    loadSearchIndex();

    // Setup features
    setupSearch();
    setupIndexPage();
    setupAuthUI();

    // RFD page features
    if (window.__ANNOTATIONS__) {
      renderAnnotations(window.__ANNOTATIONS__);
      setupTextSelection();
      loadPrComments();
      checkActiveRevision();
    }
  });

})();
